# App
APP_NAME=TalentOS
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Supabase PostgreSQL (replace with your Supabase connection string)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# JWT (generate a strong secret: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cohere API
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_GENERATE_MODEL=command-r-plus

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","https://your-domain.com"]

# Vector
VECTOR_DIMENSION=1024
